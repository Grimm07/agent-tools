[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
dependencies = []

[project.scripts]
{{ slug }} = "{{ py_module }}.cli:main"

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff>=0.6",
    "mypy>=1.10",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ py_module }}"]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "B", "UP", "I", "SIM"]

[tool.mypy]
python_version = "3.11"
strict = true

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-v"
