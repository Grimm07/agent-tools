package {{ go_pkg }}

import (
	"bytes"
	"context"
	"errors"
	"fmt"
	"os/exec"
	"time"
)

// maxOutputBytes caps captured combined output of any executed command so tool
// responses stay bounded regardless of how chatty a command is.
const maxOutputBytes = 64 * 1024

// defaultCommandTimeout bounds command tools when the caller does not supply one.
const defaultCommandTimeout = 2 * time.Minute

// CommandResult is the outcome of running an allowlisted command.
type CommandResult struct {
	// ExitCode is the process exit status (0 on success). A non-zero exit is a
	// normal result, not a Go error.
	ExitCode int `json:"exit_code"`
	// Output is the combined stdout+stderr, truncated to maxOutputBytes.
	Output string `json:"output"`
	// TimedOut is true if the command was killed by the context deadline.
	TimedOut bool `json:"timed_out"`
}

// RunCommand executes the allowlisted argv configured under cfg.Commands[name].
//
// Security: the argv is taken verbatim from config and run via
// exec.CommandContext with separate arguments — never through a shell — so no
// caller-supplied string is ever interpreted. The command runs in cfg.Root
// under a context timeout, and its output is capped.
func RunCommand(ctx context.Context, cfg Config, name string, timeout time.Duration) (CommandResult, error) {
	argv := cfg.Commands[name]
	if len(argv) == 0 {
		return CommandResult{}, fmt.Errorf("command %q not configured", name)
	}
	return execArgv(ctx, cfg.Root, argv, timeout)
}

// execArgv runs argv in dir under a timeout, capturing capped combined output.
// argv[0] is the program; argv[1:] are its arguments. No shell is involved.
func execArgv(ctx context.Context, dir string, argv []string, timeout time.Duration) (CommandResult, error) {
	if len(argv) == 0 {
		return CommandResult{}, errors.New("empty argv")
	}
	if timeout <= 0 {
		timeout = defaultCommandTimeout
	}
	ctx, cancel := context.WithTimeout(ctx, timeout)
	defer cancel()

	cmd := exec.CommandContext(ctx, argv[0], argv[1:]...)
	cmd.Dir = dir

	var buf cappedBuffer
	cmd.Stdout = &buf
	cmd.Stderr = &buf

	err := cmd.Run()

	res := CommandResult{Output: buf.String()}
	if ctx.Err() == context.DeadlineExceeded {
		res.TimedOut = true
		res.ExitCode = -1
		return res, nil
	}
	if err != nil {
		var exitErr *exec.ExitError
		if errors.As(err, &exitErr) {
			res.ExitCode = exitErr.ExitCode()
			return res, nil
		}
		// Could not start the program at all (e.g. not found): surface as error.
		return CommandResult{}, fmt.Errorf("run %q: %w", argv[0], err)
	}
	res.ExitCode = 0
	return res, nil
}

// cappedBuffer is an io.Writer that retains at most maxOutputBytes, appending a
// truncation marker once the cap is reached. Excess writes are discarded but
// still "accepted" so the child process is not blocked on a full pipe.
type cappedBuffer struct {
	buf       bytes.Buffer
	truncated bool
}

func (c *cappedBuffer) Write(p []byte) (int, error) {
	if c.buf.Len() >= maxOutputBytes {
		c.markTruncated()
		return len(p), nil
	}
	room := maxOutputBytes - c.buf.Len()
	if room >= len(p) {
		return c.buf.Write(p)
	}
	c.buf.Write(p[:room])
	c.markTruncated()
	return len(p), nil
}

func (c *cappedBuffer) markTruncated() {
	if !c.truncated {
		c.truncated = true
		c.buf.WriteString("\n... [output truncated]\n")
	}
}

func (c *cappedBuffer) String() string { return c.buf.String() }
