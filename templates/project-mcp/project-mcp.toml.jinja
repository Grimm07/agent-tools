# Configuration for the {{ name }} project-mcp server.
#
# Edit this file to point the server at a project and enable the command tools.
# It is read at startup, so changes take effect on the next run — no re-scaffold.

# Project root the server operates within (relative to this config file).
root = "."

[commands]
# Each entry is an argv array (NOT a shell string). Empty/absent = tool disabled.
# Only these exact argv are ever executed — there is no arbitrary-exec tool.
{% if test_command %}test = {{ test_command }}{% else %}# test = ["go", "test", "./..."]{% endif %}

{% if lint_command %}lint = {{ lint_command }}{% else %}# lint = ["golangci-lint", "run"]{% endif %}

{% if build_command %}build = {{ build_command }}{% else %}# build = ["go", "build", "./..."]{% endif %}


[docs]
# Files or directories (under root) exposed via the docs tools.
paths = ["README.md", "CLAUDE.md", "docs"]
